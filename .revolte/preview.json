{
  "version": 2,
  "start": "npx next dev --turbopack --hostname 0.0.0.0 --port 4173",
  "port": 4173,
  "install": [
    {
      "name": "npm deps",
      "check": "test -d node_modules",
      "run": "npm ci",
      "inputs": ["package.json", "package-lock.json"]
    },
    {
      "name": "database schema",
      "check": "test -f dev.db",
      "run": "npm run db:migrate",
      "inputs": ["drizzle/0000_daily_adam_warlock.sql"]
    }
  ]
}
